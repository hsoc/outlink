{
  "expo": {
    "name": "Outlink",
    "slug": "outlink",
    "version": "1.1.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "outlink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "io.github.hsoc.outlink",
      "buildNumber": "16",
      "supportsTablet": true
    },
    "android": {
      "versionCode": 16,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "package": "io.github.hsoc.outlink"
    },
    "plugins": [
      "./plugins/with-ios-signing",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3A76F0",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "enableFTS": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "zh",
            "zh-Hant",
            "ar",
            "de",
            "es",
            "fa",
            "fr",
            "hi",
            "hu",
            "it",
            "ja",
            "ko",
            "pl",
            "pt-BR",
            "pt-PT",
            "ru",
            "th",
            "tr"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Outlink to select a nearby public area channel. Exact coordinates are not published."
        }
      ],
      "./plugins/with-proximity-bluetooth",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Outlink to scan contact verification codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "./plugins/with-local-notifications"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
