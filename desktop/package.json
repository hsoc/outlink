{
  "name": "outlink-desktop",
  "version": "26.10.5",
  "license": "MIT",
  "description": "Electron runtime for the Outlink encrypted messenger",
  "author": {
    "name": "Outlink contributors"
  },
  "private": true,
  "repository": "https://github.com/hsoc/outlink",
  "main": "dist/main.js",
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.3",
    "write-file-atomic": "^7.0.1",
    "yauzl": "^3.4.0"
  },
  "build": {
    "appId": "io.github.hsoc.outlink",
    "productName": "Outlink",
    "directories": {
      "output": "../release"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*"
    ],
    "asarUnpack": [
      "dist/native/**/*",
      "dist/database-worker.js",
      "node_modules/better-sqlite3/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "extraResources": [
      {
        "from": "../licenses",
        "to": "ThirdPartyNotices/licenses",
        "filter": ["**/*"]
      },
      {
        "from": "..",
        "to": "ThirdPartyNotices",
        "filter": ["LICENSE", "THIRD_PARTY_NOTICES.md"]
      },
      {
        "from": "../node_modules/electron/dist",
        "to": "ThirdPartyNotices/electron",
        "filter": ["LICENSE", "LICENSES.chromium.html"]
      },
      {
        "from": "../assets/images/tray",
        "to": "tray",
        "filter": ["**/*.png"]
      },
      {
        "from": "native/proximity/bin",
        "to": "proximity",
        "filter": ["**/*"]
      }
    ],
    "protocols": [
      {
        "name": "Outlink",
        "schemes": ["outlink"]
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "../assets/images/icon.png",
      "category": "public.app-category.social-networking",
      "forceCodeSigning": true,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Allow Outlink to discover and communicate with nearby Outlink users.",
        "NSCameraUsageDescription": "Allow Outlink to use the camera to take photos and scan QR codes.",
        "NSMicrophoneUsageDescription": "Allow Outlink to use the microphone to record voice messages."
      }
    },
    "win": {
      "target": "nsis",
      "icon": "../assets/images/icon.png",
      "publish": {
        "provider": "github",
        "owner": "hsoc",
        "repo": "outlink",
        "channel": "latest-${arch}",
        "releaseType": "draft"
      }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "../assets/images/icon.png",
      "category": "Network"
    },
    "publish": {
      "provider": "github",
      "owner": "hsoc",
      "repo": "outlink",
      "releaseType": "draft"
    }
  }
}
