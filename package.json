{
  "name": "outlink",
  "main": "index.ts",
  "version": "1.1.4",
  "license": "MIT",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    }
  },
  "dependencies": {
    "@cashu/cashu-ts": "4.13.0",
    "@libp2p/noise": "1.0.1",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^2.2.0",
    "@solar-icons/react-native": "^1.1.1",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.17",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.17",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.3.0",
    "lucide-react-native": "^1.38.0",
    "nostr-tools": "2.25.2",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "uint8arraylist": "2.4.8",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "EXPO_PUBLIC_APP_ENV=development expo start --dev-client --lan",
    "android:dev": "EXPO_PUBLIC_APP_ENV=development expo run:android --device --no-bundler",
    "android:prebuild:dev": "EXPO_PUBLIC_APP_ENV=development expo prebuild --platform android --clean --no-install",
    "ios:dev": "EXPO_PUBLIC_APP_ENV=development expo run:ios --device --no-bundler",
    "ios:prebuild:dev": "EXPO_PUBLIC_APP_ENV=development expo prebuild --platform ios --clean",
    "android:prebuild": "EXPO_PUBLIC_APP_ENV=production expo prebuild --platform android --clean --no-install",
    "android:build": "cd android && EXPO_PUBLIC_APP_ENV=production ./gradlew :app:assembleRelease --no-daemon --no-parallel --max-workers=1 --console=plain --info --stacktrace",
    "ios:prebuild": "EXPO_PUBLIC_APP_ENV=production expo prebuild --platform ios --clean",
    "ios:build": "EXPO_PUBLIC_APP_ENV=production expo run:ios --configuration Release --device --no-bundler",
    "ios:archive": "mkdir -p release && EXPO_PUBLIC_APP_ENV=production xcodebuild -workspace ios/Outlink.xcworkspace -scheme Outlink -configuration Release -destination 'generic/platform=iOS' -archivePath \"$PWD/release/Outlink.xcarchive\" -allowProvisioningUpdates archive",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "postinstall": "patch-package --error-on-fail",
    "licenses:generate": "node scripts/generate-mobile-licenses.mjs",
    "licenses:refresh": "node scripts/generate-mobile-licenses.mjs --refresh",
    "licenses:check": "node scripts/generate-mobile-licenses.mjs --check",
    "licenses:test": "node --test scripts/licenses/*.test.mjs",
    "android:apk": "node scripts/mobile-android-build.mjs",
    "check:mobile": "node --test scripts/mobile-config.test.mjs scripts/history-storage.test.mjs",
    "export:mobile": "expo export --platform android --platform ios --output-dir dist/mobile"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^#alloc$": "<rootDir>/node_modules/uint8arrays/dist/src/alloc.js",
      "^#compare$": "<rootDir>/node_modules/uint8arrays/dist/src/compare.js",
      "^#concat$": "<rootDir>/node_modules/uint8arrays/dist/src/concat.js",
      "^#from-string$": "<rootDir>/node_modules/uint8arrays/dist/src/from-string.js",
      "^#to-string$": "<rootDir>/node_modules/uint8arrays/dist/src/to-string.js",
      "^#util/as-uint8array$": "<rootDir>/node_modules/uint8arrays/dist/src/util/as-uint8array.js",
      "^uint8arraylist$": "<rootDir>/node_modules/uint8arraylist/dist/src/index.js",
      "^uint8arrays$": "<rootDir>/node_modules/uint8arrays/dist/src/index.js",
      "^uint8arrays/(.*)$": "<rootDir>/node_modules/uint8arrays/dist/src/$1.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@libp2p/noise|@cashu/.*|@noble/.*|@scure/.*|nostr-tools|react-navigation|@react-navigation/.*|react-native-svg|uint8arraylist|uint8arrays))"
    ]
  },
  "private": true
}
